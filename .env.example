# Admin Configuration
# Your WhatsApp number without + or country code (e.g., 628123456789)
ADMIN_NUMBER=

# OpenAI/Model Provider Configuration
# API key for your OpenAI-compatible service
OPENAI_API_KEY=your-api-key-here
# Base URL for the model provider API
OPENAI_BASE_URL=http://localhost:20128/v1
# AI model name to use for message classification
AI_MODEL_NAME=ultimate

# Storage Configuration
# Directory path for storing JSON files
STORAGE_DIR=./storage
# Directory path for WhatsApp authentication state
AUTH_STATE_DIR=auth

# Cache Configuration (in seconds)
# Cache TTL for group metadata in CacheStorage
CACHE_TTL_SECONDS=300
# Cache TTL for group metadata in WASocket
GROUP_CACHE_TTL_SECONDS=900

# Cron Configuration
# How often to process unsent messages (in minutes)
BATCH_FORWARD_INTERVAL_MINUTES=30
# How long to keep messages before deletion (in days, minimum 1)
CLEANUP_RETENTION_DAYS=7

# MySQL Configuration (for Docker)
# Database connection details
DATABASE_USER=autoforward
DATABASE_PASSWORD=autoforward_secure_password
DATABASE_NAME=autoforward
DATABASE_HOST=mysql
DATABASE_PORT=3306
# Full connection string (Docker will use mysql service name as host)
DATABASE_URL="mysql://autoforward:autoforward_secure_password@mysql:3306/autoforward"
